* text=auto eol=lf

# Preserve source-bound evidence bytes, including original CSV line endings.
docs/benchmarks/** -text
docs/verification/** -text
docs/references/** -text
assets/graphs/** -text
*.csv whitespace=cr-at-eol

# Preserve literal context lines and generated SVG path whitespace.
*.patch whitespace=-blank-at-eol,-blank-at-eof
*.svg whitespace=-blank-at-eol
