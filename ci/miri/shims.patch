+#[target_feature(enable = "neon")]
+unsafe fn test_vhsubq_s32() {
+    for (a, b, expected) in [
+        (
+            [i32::MIN, i32::MAX, i32::MIN, i32::MAX],
+            [i32::MAX, i32::MIN, i32::MIN, i32::MAX],
+            [i32::MIN, i32::MAX, 0, 0],
+        ),
+        ([0, 0, 3, -3], [1, -1, 0, 0], [-1, 0, 1, -2]),
+        (
+            [i32::MIN, i32::MAX, -1, 1],
+            [0, 0, i32::MAX, i32::MIN],
+            [-1_073_741_824, 1_073_741_823, -1_073_741_824, 1_073_741_824],
+        ),
+    ] {
+        let got: [i32; 4] = transmute(vhsubq_s32(transmute(a), transmute(b)));
+        assert_eq!(got, expected);
+    }
+    let values = [
+        i32::MIN,
+        i32::MIN + 1,
+        -(1 << 30),
+        -3,
+        -2,
+        -1,
+        0,
+        1,
+        2,
+        3,
+        1 << 30,
+        i32::MAX - 1,
+        i32::MAX,
+    ];
+    for a in values {
+        for b in values {
+            let want = ((i64::from(a) - i64::from(b)) >> 1) as i32;
+            let got: [i32; 4] = transmute(vhsubq_s32(vdupq_n_s32(a), vdupq_n_s32(b)));
+            assert_eq!(got, [want; 4], "{a} - {b}");
+        }
+    }
+}
+
+#[target_feature(enable = "neon")]
+unsafe fn test_vrshlq_s32() {
+    for (a, shifts, expected) in [
+        ([3, 5, -3, -5], [-1; 4], [2, 3, -1, -2]),
+        ([i32::MIN, i32::MAX, -1, 1], [-31, -31, -32, -32], [-1, 1, 0, 0]),
+        ([i32::MIN, i32::MAX, i32::MIN, i32::MAX], [-32, -32, -33, -33], [0; 4]),
+        ([i32::MIN, i32::MAX, -1, 1], [-33, -128, 32, 127], [0; 4]),
+        ([i32::MIN, i32::MAX, -1, 1], [0, 1, 31, 31], [i32::MIN, -2, i32::MIN, i32::MIN]),
+        // Only the signed low byte of each shift count is used.
+        ([3, -3, 123, -123], [255, -257, 256, -256], [2, -1, 123, -123]),
+    ] {
+        let got: [i32; 4] = transmute(vrshlq_s32(transmute(a), transmute(shifts)));
+        assert_eq!(got, expected);
+    }
+}
+
+#[target_feature(enable = "neon")]
+unsafe fn test_vsliq() {
+    let a = transmute([u32::MAX, 0x1234_5678, 0xaaaa_aaaa, 0]);
+    let b = transmute([0u32, u32::MAX, 0x0123_4567, 0x8765_4321]);
+    assert_eq!(transmute::<_, [u32; 4]>(vsliq_n_u32::<0>(a, b)), transmute::<_, [u32; 4]>(b));
+    assert_eq!(
+        transmute::<_, [u32; 4]>(vsliq_n_u32::<4>(a, b)),
+        [0xf, 0xffff_fff8, 0x1234_567a, 0x7654_3210],
+    );
+    assert_eq!(
+        transmute::<_, [u32; 4]>(vsliq_n_u32::<31>(a, b)),
+        [0x7fff_ffff, 0x9234_5678, 0xaaaa_aaaa, 0x8000_0000],
+    );
+
+    let a = transmute([0xffffu16, 0x1234, 0xaaaa, 0, 0xffff, 1, 0x8000, 0x5555]);
+    let b = transmute([0u16, 0xffff, 0x1234, 0x8001, 1, 0x8000, 0xffff, 0xaaaa]);
+    assert_eq!(transmute::<_, [u16; 8]>(vsliq_n_u16::<0>(a, b)), transmute::<_, [u16; 8]>(b));
+    assert_eq!(
+        transmute::<_, [u16; 8]>(vsliq_n_u16::<4>(a, b)),
+        [0xf, 0xfff4, 0x234a, 0x10, 0x1f, 1, 0xfff0, 0xaaa5],
+    );
+    assert_eq!(
+        transmute::<_, [u16; 8]>(vsliq_n_u16::<15>(a, b)),
+        [0x7fff, 0x9234, 0x2aaa, 0x8000, 0xffff, 1, 0x8000, 0x5555],
+    );
+}
